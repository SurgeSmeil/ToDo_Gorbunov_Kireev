<Page x:Class="Desktop.MainTasks"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задачи" Height="700" Width="1200" Foreground="#FFEDE5E5">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Storyboard x:Key="CheckBoxCheckedAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="1.3">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>

    <Grid Background="White">
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="60" Background="White" x:Name="LeftPanel">
            <StackPanel VerticalAlignment="Top" Margin="0,20,0,0">
                <Border Width="40" Height="40" CornerRadius="20" Background="#FF007ACC" 
                       Margin="10,20,10,10">
                    <TextBlock x:Name="AvatarTextBlock" Text="A" Foreground="White" FontSize="16" FontWeight="Bold"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="UserNameTextBlock" Text="USER" Foreground="#FF050505" 
                          HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,20"/>

                <Button Content="+" Width="41" Height="40" Background="#FF007ACC" 
                       Foreground="White" BorderBrush="#FF007ACC" Margin="10,0,10,20"
                       FontSize="20" FontWeight="Bold" Click="AddTaskButton_Click">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>

                <Button x:Name="HistoryButton" Content="✓" Width="41" Height="40" 
                       Background="#FF28a745" Foreground="White" 
                       BorderBrush="#FF28a745" Margin="10,0,10,20"
                       FontSize="18" FontWeight="Bold" Click="HistoryButton_Click"
                       ToolTip="Показать историю выполненных задач">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="0"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </Button.RenderTransform>
                </Button>

                <Button x:Name="LogoutButton" Content="←" Width="41" Height="40" 
                       Background="#FF6c757d" Foreground="White" 
                       BorderBrush="#FF6c757d" Margin="10,0,10,0"
                       FontSize="18" FontWeight="Bold" Click="LogoutButton_Click"
                       ToolTip="Выйти из профиля"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="156*"/>
                <ColumnDefinition Width="29*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="60" Background="#FF007ACC" Grid.ColumnSpan="2" BorderBrush="#FF007ACC">
                <StackPanel x:Name="CategoriesPanel" Orientation="Horizontal" 
                           VerticalAlignment="Center" Margin="20,0">
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="White" Grid.ColumnSpan="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="White">
                    <StackPanel x:Name="TasksPanel" Margin="20">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="White">
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="60" Background="#FF007ACC" BorderBrush="#FF007ACC">
                    <TextBlock x:Name="SelectedTaskTitle" Text="Заголовок" 
                              Foreground="White" FontSize="16" FontWeight="Bold"
                              VerticalAlignment="Center" Margin="20,0"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#FFEDEDED">
                    <StackPanel Margin="20">
                        <TextBlock x:Name="SelectedTaskDate" Text="18:00 01 Января 2022" 
                                  Foreground="#FF007ACC" FontSize="14" Margin="0,0,0,20"/>

                        <TextBlock x:Name="SelectedTaskDescription" 
                                  Text="Lorem ipsum dolor sit amet, consectetur adipiscing." 
                                  Foreground="Black" TextWrapping="Wrap" FontSize="14"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Height="100" Background="#FFD2D2D2">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" 
                               VerticalAlignment="Center" Margin="20">
                        <Button x:Name="CompleteButton" Content="Готово" Width="100" Height="35" 
                               Background="#FFE84A4A" Foreground="White" 
                               BorderBrush="{x:Null}"
                               Click="CompleteButton_Click" IsEnabled="False">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>

                        <Button x:Name="DeleteButton" Content="Удалить" Width="100" Height="35" 
                               Background="#FFE81123" Foreground="White" 
                               BorderBrush="{x:Null}" Click="DeleteButton_Click" IsEnabled="False">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Button.RenderTransform>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>